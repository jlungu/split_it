PORT=3001
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Comma-separated allowed origins. Add your Vercel URL + any preview URLs.
# *.vercel.app preview URLs are automatically allowed without listing them here.
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173

# Optional email allowlist — only these addresses can use the API.
# Leave unset to allow any authenticated user.
ALLOWED_EMAILS=you@example.com,friend@example.com
